{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", ".bun-version", "tsconfig.base.json"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "JWT_SECRET",
    "TELEGRAM_BOT_TOKEN",
    "FRONTEND_URL",
    "S3_ENDPOINT",
    "S3_BUCKET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": [
        "VITE_API_URL",
        "VITE_WS_URL",
        "VITE_BUILD_SHA",
        "VITE_DEFAULT_THEME",
        "VITE_DEV_MOCK_INIT_DATA"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.shared.mjs"],
      "outputs": []
    },
    "type-check": {
      "outputs": []
    },
    "test": {
      "outputs": ["coverage/**"],
      "env": ["SKIP_PG_TESTS", "ALLOW_ANY_TEST_DB"]
    },
    "generate": {
      "cache": false
    },
    "migrate": {
      "cache": false
    },
    "studio": {
      "cache": false,
      "persistent": true
    },
    "seed": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
