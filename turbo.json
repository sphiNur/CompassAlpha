{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", ".bun-version", "tsconfig.base.json"],
  "globalEnv": ["NODE_ENV", "DATABASE_URL", "REDIS_URL", "JWT_SECRET", "TELEGRAM_BOT_TOKEN", "FRONTEND_URL", "S3_ENDPOINT", "S3_BUCKET"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".vite/**", ".turbo/**", "lingui/**"],
      "env": ["VITE_API_URL", "VITE_WS_URL", "VITE_BUILD_SHA", "VITE_DEFAULT_THEME", "VITE_DEV_MOCK_INIT_DATA"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "type-check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "generate": {
      "cache": false
    },
    "migrate": {
      "cache": false
    },
    "studio": {
      "cache": false,
      "persistent": true
    },
    "seed": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
