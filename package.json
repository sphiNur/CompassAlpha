{
  "name": "compass-alpha",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:api": "pnpm --filter @compass/api dev",
    "dev:web": "pnpm --filter @compass/web dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check && tsc -p scripts",
    "test": "bun run scripts/unit-tests.ts",
    "test:e2e": "pnpm --filter @compass/e2e e2e",
    "db:generate": "pnpm --filter @compass/db generate",
    "db:migrate": "pnpm --filter @compass/db migrate",
    "db:studio": "pnpm --filter @compass/db studio",
    "db:seed": "pnpm --filter @compass/db seed",
    "compass": "pnpm --filter @compass/cli start --",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,css}\"",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "playwright": "1.64.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
