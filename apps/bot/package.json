{
  "name": "@compass/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "build": "bun build src/main.ts --outdir dist --target bun",
    "start": "bun run dist/main.js",
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "grammy": "^1.34.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/bun": "1.4.4",
    "eslint": "^9.39.4",
    "typescript-eslint": "^8.59.3"
  }
}
