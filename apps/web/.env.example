# Vite-specific env file for local web development.
#
# Copy this file to apps/web/.env for local UI work. Production deploys
# keep server-side .env files separate and must not include dev mock data.

VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/ws
VITE_DEFAULT_THEME=native

# Optional local-only browser login switch. When paired with
# DEV_MOCK_LOGIN_ENABLED=true on the API, localhost can auto-login with the
# first active member. Add ?devLogin=choose to the URL to pick a test persona.
# Leave blank by default. If set, production builds abort.
VITE_DEV_MOCK_INIT_DATA=
