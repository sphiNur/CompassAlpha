# ---- API ----
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# DB
DATABASE_URL=postgres://compass:compass@localhost:5432/compass
DATABASE_URL_DIRECT=postgres://compass:compass@localhost:5432/compass

# Cache + queues
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production-please-use-a-256-bit-random
JWT_REFRESH_SECRET=change-me-too-please

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Claim auto-release: the worker scans the queue every
# CLAIM_TIMEOUT_SCAN_MINUTES and releases any claim sitting idle past
# CLAIM_TIMEOUT_MINUTES. Set CLAIM_TIMEOUT_MINUTES=0 to disable.
CLAIM_TIMEOUT_MINUTES=30
CLAIM_TIMEOUT_SCAN_MINUTES=5

# Bot delivery transport (see apps/worker/src/main.ts for selection logic).
#
# Production: deploy infra/cloudflare/tg-relay.js as a CF Worker, then set:
#   TG_RELAY_URL=https://tg-relay.<your-account>.workers.dev
#   COMPASS_RELAY_KEY=<32+ hex bytes, must match the Worker secret>
#   BOT_DELIVERY_ENABLED=true   # default-on once relay is configured
#
# Where api.telegram.org is reachable directly, leave the relay vars empty
# and set BOT_DELIVERY_ENABLED=true to enable the grammY path.
#
# Leave BOT_DELIVERY_ENABLED unset/false in dev — bot rows drain silently.
TG_RELAY_URL=
COMPASS_RELAY_KEY=
BOT_DELIVERY_ENABLED=false

# Storage (R2 / MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=compass-uploads
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_PUBLIC_BASE=http://localhost:9000/compass-uploads

# Frontend
FRONTEND_URL=http://localhost:5173

# OTel
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=compass-api

# ---- Web (VITE_*) ----
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/ws
VITE_DEFAULT_THEME=native
VITE_BUILD_SHA=dev
VITE_DEV_MOCK_INIT_DATA=
