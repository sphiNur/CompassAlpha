# ---- API ----
NODE_ENV=development
COMPASS_RELEASE_CHANNEL=development
PORT=3000
HOST=0.0.0.0

# DB
DATABASE_URL=postgres://compass:compass@localhost:5432/compass
DATABASE_URL_DIRECT=postgres://compass:compass@localhost:5432/compass

# Cache + queues
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production-please-use-a-256-bit-random
JWT_REFRESH_SECRET=change-me-too-please-use-a-256-bit-random

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Local browser automation / persona login identity. It only works when
# NODE_ENV and COMPASS_RELEASE_CHANNEL are both development, and the request
# comes from localhost / 127.0.0.1. Pair with apps/web/.env:
# VITE_DEV_MOCK_INIT_DATA=1. The local DB must be migrated and have at least
# one active member; production builds reject this client variable.
DEV_MOCK_LOGIN_ENABLED=false

# Browser-only login for development/staging diagnostics.
#
# OFF by default. Production releases must leave this disabled.
# To test the deployed web UI outside Telegram, set:
#   COMPASS_RELEASE_CHANNEL=staging
#   NON_TELEGRAM_LOGIN_ENABLED=true
#   NON_TELEGRAM_LOGIN_USERS=6402913074:random-32-char-code
#
# Format: comma-separated tgUserId:accessCode pairs. The Telegram user
# must already exist in the app and have an active membership.
NON_TELEGRAM_LOGIN_ENABLED=false
NON_TELEGRAM_LOGIN_USERS=
# Claim auto-release: the worker scans the queue every
# CLAIM_TIMEOUT_SCAN_MINUTES and releases any claim sitting idle past
# CLAIM_TIMEOUT_MINUTES. Set CLAIM_TIMEOUT_MINUTES=0 to disable.
CLAIM_TIMEOUT_MINUTES=30
CLAIM_TIMEOUT_SCAN_MINUTES=5

# Bot delivery transport (see apps/worker/src/main.ts for selection logic).
#
# Production: deploy infra/cloudflare/tg-relay.js as a CF Worker, then set:
#   TG_RELAY_URL=https://tg-relay.<your-account>.workers.dev
#   COMPASS_RELAY_KEY=<32+ hex bytes, must match the Worker secret>
#   BOT_DELIVERY_ENABLED=true   # default-on once relay is configured
#
# Where api.telegram.org is reachable directly, leave the relay vars empty
# and set BOT_DELIVERY_ENABLED=true to enable the grammY path.
#
# Leave BOT_DELIVERY_ENABLED unset/false in dev — bot rows drain silently.
TG_RELAY_URL=
COMPASS_RELAY_KEY=
BOT_DELIVERY_ENABLED=false

# Storage (R2 / MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=compass-uploads
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_PUBLIC_BASE=http://localhost:9000/compass-uploads

# Frontend
FRONTEND_URL=http://localhost:5173

# OTel
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
