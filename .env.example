# ---- API ----
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# DB
DATABASE_URL=postgres://compass:compass@localhost:5432/compass
DATABASE_URL_DIRECT=postgres://compass:compass@localhost:5432/compass

# Cache + queues
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production-please-use-a-256-bit-random
JWT_REFRESH_SECRET=change-me-too-please

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Storage (R2 / MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=compass-uploads
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_PUBLIC_BASE=http://localhost:9000/compass-uploads

# Frontend
FRONTEND_URL=http://localhost:5173

# OTel
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=compass-api

# ---- Web (VITE_*) ----
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/ws
VITE_DEFAULT_THEME=native
VITE_BUILD_SHA=dev
VITE_DEV_MOCK_INIT_DATA=
