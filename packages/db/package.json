{
  "name": "@compass/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts",
    "./rls": "./src/rls.ts"
  },
  "scripts": {
    "generate": "echo 'Refused: migrations are hand-written (CONTRIBUTING.md section 5). meta/ holds only the 0000 snapshot, so drizzle-kit generate would diff against the first schema and emit a wrong, possibly destructive, migration.' >&2 && exit 1",
    "migrate": "bun run src/migrate.ts",
    "studio": "drizzle-kit studio --config drizzle.config.ts",
    "seed": "bun run src/seed.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.5",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
