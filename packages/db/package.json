{
  "name": "@compass/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/repoEnv.ts",
    "./seed-data": "./src/seed-data.ts",
    "./app-role": "./src/appRole.ts"
  },
  "scripts": {
    "generate": "echo 'Refused: migrations are hand-written (CONTRIBUTING.md section 5). meta/ holds only the 0000 snapshot, so drizzle-kit generate would diff against the first schema and emit a wrong, possibly destructive, migration.' >&2 && exit 1",
    "migrate": "bun run src/migrate.ts",
    "studio": "drizzle-kit studio --config drizzle.config.ts",
    "seed": "bun run src/seed.ts",
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.5",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@compass/contracts": "workspace:*",
    "@compass/i18n": "workspace:*",
    "@eslint/js": "^9.39.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.4",
    "typescript-eslint": "^8.59.3"
  }
}
