[Unit]
Description=CompassAlpha API (Hono + tRPC on Bun)
Documentation=https://github.com/sphiNur/CompassAlpha/blob/main/docs/RUNBOOK.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/compass-alpha/apps/api
EnvironmentFile=/home/ubuntu/compass-alpha/.env
Environment=PATH=/home/ubuntu/.bun/bin:/usr/local/bin:/usr/bin:/bin
# The .env is applied over this, so the deploy refuses an .env that sets
# NODE_ENV or COMPASS_RELEASE_CHANNEL to anything but production (OPS-22).
Environment=NODE_ENV=production
ExecStart=/home/ubuntu/.bun/bin/bun run src/main.ts
Restart=on-failure
RestartSec=3
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=compass-api

# Hardening — same posture as compass-backup.service. Comment out any
# line that conflicts with a future feature (e.g. NoNewPrivileges=true
# would block sudo from within the api process; the api never escalates,
# so this is safe).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# Allow writes to /home/ubuntu/compass-alpha (the deploy target) and
# nothing else under /home. Tighten further if logs / dist move.
ReadWritePaths=/home/ubuntu/compass-alpha

[Install]
WantedBy=multi-user.target
